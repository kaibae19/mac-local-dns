#!/bin/sh
# mac-local-dns - Fix macOS DNS for local domains when on VPN
# https://github.com/kaibae19/mac-local-dns

RESOLVER_DIR="/etc/resolver"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

show_resolvers() {
    echo "${CYAN}=== Local DNS Resolvers ===${NC}"
    if [ -d "$RESOLVER_DIR" ] && [ -n "$(ls -A $RESOLVER_DIR 2>/dev/null)" ]; then
        for f in "$RESOLVER_DIR"/*; do
            [ -f "$f" ] || continue
            domain=$(basename "$f")
            dns=$(grep nameserver "$f" | awk '{print $2}')
            echo "  ${GREEN}$domain${NC} → $dns"
        done
    else
        echo "  ${YELLOW}(none)${NC}"
    fi
    echo ""
}

add_domain() {
    printf "Domain: "
    read domain
    [ -z "$domain" ] && return
    
    printf "DNS server [192.168.1.1]: "
    read dns
    dns="${dns:-192.168.1.1}"
    
    sudo mkdir -p "$RESOLVER_DIR"
    echo "nameserver $dns" | sudo tee "$RESOLVER_DIR/$domain" > /dev/null
    echo "${GREEN}✓${NC} Added ${CYAN}$domain${NC} → $dns"
}

remove_domain() {
    printf "Domain to remove: "
    read domain
    [ -z "$domain" ] && return
    
    if [ -f "$RESOLVER_DIR/$domain" ]; then
        sudo rm -f "$RESOLVER_DIR/$domain"
        echo "${GREEN}✓${NC} Removed ${CYAN}$domain${NC}"
    else
        echo "${RED}✗${NC} Not found: $domain"
    fi
}

interactive_menu() {
    echo "${CYAN}"
    echo "╔═══════════════════════════════════════╗"
    echo "║   macOS Local DNS Resolver Manager    ║"
    echo "╚═══════════════════════════════════════╝"
    echo "${NC}"
    
    while true; do
        echo ""
        show_resolvers
        echo "${CYAN}[A]${NC}dd  ${CYAN}[R]${NC}emove  ${CYAN}[Q]${NC}uit"
        printf "> "
        read choice
        
        choice=$(echo "$choice" | tr '[:upper:]' '[:lower:]')
        case "$choice" in
            a) add_domain ;;
            r) remove_domain ;;
            q) exit 0 ;;
            *) echo "${RED}Invalid option${NC}" ;;
        esac
    done
}

# CLI or interactive
case "$1" in
    add)
        [ -z "$2" ] || [ -z "$3" ] && { echo "Usage: $0 add <domain> <dns>"; exit 1; }
        sudo mkdir -p "$RESOLVER_DIR"
        echo "nameserver $3" | sudo tee "$RESOLVER_DIR/$2" > /dev/null
        echo "Added $2 → $3"
        ;;
    remove|rm)
        [ -z "$2" ] && { echo "Usage: $0 remove <domain>"; exit 1; }
        sudo rm -f "$RESOLVER_DIR/$2" && echo "Removed $2"
        ;;
    list|status|ls)
        show_resolvers
        ;;
    help|-h|--help)
        echo "Usage: $0 [add <domain> <dns> | remove <domain> | list]"
        echo "       $0                # interactive mode"
        ;;
    "")
        interactive_menu
        ;;
    *)
        echo "Unknown command: $1"
        exit 1
        ;;
esac
